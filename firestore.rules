rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    // Function 1: Checks if the user is logged in.
    // Returns true if they are logged in, false otherwise.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function 2: Gets the roles of the currently logged-in user.
    // It looks up the user's document in the 'users' collection
    // and retrieves the 'roles' field (assuming it's an array or map).
    // IMPORTANT: This requires a rule allowing reads on /users/{userId} for the requesting user.
    function getUserRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Function 3: Checks if the logged-in user has a specific role.
    // It first checks if the user is logged in, then checks if the role exists in their roles list.
    // Example: hasRole('SuperAdmin') checks if 'SuperAdmin' is one of the user's roles.
    function hasRole(role) {
      // We use resource.data[role] == true if roles are stored as a map like { SuperAdmin: true, FinanceManager: false }
      // We use role in getUserRoles() if roles are stored as an array like ['FinanceManager', 'Candidate']
      // Let's assume roles are stored as an array for this example based on your original rules.
      return isAuthenticated() && role in getUserRoles();
    }

    // --- Default Deny Rule ---
    // Rule 1: Security Guard's Default Instruction - Deny Everyone!
    // No one can read or write anything unless a specific rule below allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Specific Collection Rules ---

    // Rule 2: Access to User Information
    // We need rules for the 'users' collection so our role checks (`get`) work.
    match /users/{userId} {
      // Allow logged-in users to read their own user document.
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Allow logged-in users to update their own user document (e.g., profile info, NOT roles).
      // We might add more checks later to prevent users from changing their own roles.
      allow write: if isAuthenticated() && request.auth.uid == userId;
      // Maybe allow SuperAdmins to read any user document?
      // allow read: if hasRole('SuperAdmin') || (isAuthenticated() && request.auth.uid == userId);
    }

    // Rule 3: Candidate Profiles
    // Only the user who owns the profile can read or write it.
    match /candidateProfiles/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rule 4: Coupons
    match /coupons/{couponId} {
      // Allow Finance Managers or Super Admins to read coupons.
      allow read: if hasRole('FinanceManager') || hasRole('SuperAdmin');
      // Only allow Super Admins to create, update, or delete coupons.
      allow write: if hasRole('SuperAdmin');
    }

    // Rule 5: Coupon Usages
    match /couponUsages/{usageId} {
      // Allow Finance Managers or Super Admins to read usage records.
      allow read: if hasRole('FinanceManager') || hasRole('SuperAdmin');
      // Allow any logged-in user to create a usage record (e.g., when they apply a coupon).
      // We might refine this later to only allow writes during specific actions (like checkout).
      allow write: if isAuthenticated();
    }

    // Rule 6: Metrics (Covers paths like /metrics/current)
    match /metrics/{metricPath=**} {
      // Allow Finance Managers or Super Admins to read metrics.
      allow read: if hasRole('FinanceManager') || hasRole('SuperAdmin');
      // Deny writes from the app/website. Writes should only happen from your secure backend (Cloud Functions).
      allow write: if false;
    }

    // Rule 7: Metrics Snapshots
    match /metricsSnapshots/{snapshotId} {
      // Allow Finance Managers or Super Admins to read snapshots.
      allow read: if hasRole('FinanceManager') || hasRole('SuperAdmin');
      // Deny writes from the app/website.
      allow write: if false;
    }

    // Rule 8: Usage Patterns
    match /usagePatterns/{patternId} {
      // Allow Company Admins or Super Admins to read usage patterns.
      allow read: if hasRole('CompanyAdmin') || hasRole('SuperAdmin');
      // Deny writes from the app/website.
      allow write: if false;
    }

    // Remember to add rules for other collections like CompanyProfiles, Vacancies, etc., as you build them!
  }
} 